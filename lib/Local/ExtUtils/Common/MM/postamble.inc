#  Synchronize utility modules
# 
util_sync ::
	@$(EXTUTILS_COMMON_PM_TARGET) util_sync $(UPDATE_SOURCE_UTIL_FN)
	@$(EXTUTILS_COMMON_PM_TARGET) util_sync $(UPDATE_SOURCE_IMPORT_FN)


#  No arguments
#
EXTUTILS_COMMON_PM_DEFAULT=dump_param
$(EXTUTILS_COMMON_PM_DEFAULT) :
	@$(EXTUTILS_COMMON_PM_TARGET) $(EXTUTILS_COMMON_PM_DEFAULT)
